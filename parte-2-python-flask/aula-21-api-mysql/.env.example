# Copie para ".env" (o .env não vai para o GitHub).
# 1) No MySQL Workbench:  CREATE DATABASE api_flask;  USE api_flask;
# 2) Troque SUA_SENHA pela senha do seu MySQL (se o root não tiver senha, deixe vazio: root:@localhost)
DATABASE_URL=mysql+pymysql://root:SUA_SENHA@localhost/api_flask

# Sem MySQL? Remova a linha acima ou use SQLite:
# DATABASE_URL=sqlite:///usuarios.db
